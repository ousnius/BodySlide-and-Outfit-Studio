msgstr "Bones auf X-Achse tauschen (L/R)"

#: res/xrc/Actions.xrc:956
msgid "Smooth Seams"
msgstr "Normals an Rändern glätten"

#: res/xrc/Actions.xrc:1032
msgid "Set Shape Textures"
msgstr "Modelltexturen setzen"

#: res/xrc/Actions.xrc:1079
msgid "Conforming..."
msgstr "Übertrage..."

#: res/xrc/Actions.xrc:1088
msgid ""
"Use Default or pick a preset, then adjust only what needs a different "
"result. Hover options for details; some meshes still need manual cleanup."
msgstr ""

#: res/xrc/Actions.xrc:1098
msgid "Search"
msgstr "Suche"

#: res/xrc/Actions.xrc:1104
msgid "Higher values blend more vertices; lower values stay more local."
msgstr ""

#: res/xrc/Actions.xrc:1121
msgid "Radius"
msgstr ""

#: res/xrc/Actions.xrc:1122 res/xrc/Actions.xrc:1133 res/xrc/Actions.xrc:1141
msgid ""
"Distance around each outfit vertex to search for reference vertices. Larger "
"values find more matches but can cross into nearby unrelated geometry."
msgstr ""

#: res/xrc/Actions.xrc:1147
msgid "Max Targets"
msgstr "Max Ziele"

#: res/xrc/Actions.xrc:1148 res/xrc/Actions.xrc:1159 res/xrc/Actions.xrc:1167
msgid ""
"Limits how many nearby reference vertices are blended for each outfit "
"vertex. Lower values favor closest matches; higher values average more "
"movement."
msgstr ""

#: res/xrc/Actions.xrc:1173 res/xrc/WeightCopy.xrc:95
msgid "No Target Limit"
msgstr "Keine Ziellimitierung"

#: res/xrc/Actions.xrc:1174 res/xrc/Actions.xrc:1182
msgid ""
"Uses every matching reference vertex inside the search radius and disables "
"Max Vertex Targets. Turning this on sets the radius to 5.0."
msgstr ""

#: res/xrc/Actions.xrc:1198
msgid "Delta Smoothing"
msgstr "Delta-Glättung"

#: res/xrc/Actions.xrc:1204
msgid "Softens jagged slider deltas after conforming."
msgstr ""

#: res/xrc/Actions.xrc:1220
msgid "Smooth Deltas"
msgstr "Deltas glätten"

#: res/xrc/Actions.xrc:1221 res/xrc/Actions.xrc:1229
msgid ""
"Runs a smoothing pass on the conformed slider data before it is saved to the "
"outfit shape."
msgstr ""

#: res/xrc/Actions.xrc:1235
msgid "Iterations"
msgstr "Iterationen"

#: res/xrc/Actions.xrc:1236 res/xrc/Actions.xrc:1245
msgid ""
"Number of smoothing passes. More passes spread movement farther and make the "
"result softer."
msgstr ""

#: res/xrc/Actions.xrc:1251
msgid "Strength (0-1)"
msgstr "Stärke (0-1)"

#: res/xrc/Actions.xrc:1252 res/xrc/Actions.xrc:1261
msgid ""
"Blend amount for each smoothing pass. 0 leaves the deltas unchanged; 1 "
"applies the strongest smoothing."
msgstr ""

#: res/xrc/Actions.xrc:1274
msgid "Clipping Fix"
msgstr "Clipping-Fix"

#: res/xrc/Actions.xrc:1280
msgid "Reduces intersections in the new slider deltas."
msgstr "Reduziert Clipping in den neuen Slider-Deltas."

#: res/xrc/Actions.xrc:1296 res/xrc/Automation.xrc:1577
#: res/xrc/BodySlide.xrc:484 src/program/OutfitStudio.cpp:9701
#: src/program/OutfitStudio.cpp:9759 src/program/OutfitStudio.cpp:9765
#: src/program/OutfitStudio.cpp:10934
msgid "Fix Clipping"
msgstr "Clipping beheben"

#: res/xrc/Actions.xrc:1297 res/xrc/Actions.xrc:1305
msgid ""
"After each slider is conformed, adjust the result to reduce intersections "
"with the reference shape."
msgstr ""

#: res/xrc/Actions.xrc:1311
msgid "Strength (%)"
msgstr "Stärke (%)"

#: res/xrc/Actions.xrc:1312 res/xrc/Actions.xrc:1322
msgid ""
"How strongly to apply the clipping correction. Higher values push more of "
"the correction into the conformed slider."
msgstr ""

#: res/xrc/Actions.xrc:1335
msgid "Shape Movement"
msgstr "Shape Bewegung"

#: res/xrc/Actions.xrc:1341
msgid "Useful for rigid shapes or limiting movement axes."
msgstr ""

#: res/xrc/Actions.xrc:1357
msgid "No X Squeeze"
msgstr "X-Achse nicht quetschen"

#: res/xrc/Actions.xrc:1358 res/xrc/Actions.xrc:1366
msgid ""
"Only copies X movement that stays on the same side of the reference. Helps "
"avoid left/right squeezing across the center line."
msgstr ""

#: res/xrc/Actions.xrc:1372
msgid "Solid Mode"
msgstr "Festmodus"

#: res/xrc/Actions.xrc:1373 res/xrc/Actions.xrc:1381
msgid ""
"Uses one combined movement for the entire shape instead of separate per-"
"vertex movement. Useful for rigid accessories or solid objects."
msgstr ""

#: res/xrc/Actions.xrc:1387
msgid "Axes"
msgstr "Achsen"

#: res/xrc/Actions.xrc:1388
msgid ""
"Choose which axes are allowed to receive copied movement. Unchecked axes "
"keep their existing slider movement."
msgstr ""

#: res/xrc/Actions.xrc:1402
msgid "Allow conforming to write X-axis movement."
msgstr ""

#: res/xrc/Actions.xrc:1411
msgid "Allow conforming to write Y-axis movement."
