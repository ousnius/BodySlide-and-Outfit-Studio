#: res/xrc/Actions.xrc:1433
msgid "Presets"
msgstr ""

#: res/xrc/Actions.xrc:1445 src/program/OutfitStudio.cpp:9573
msgid "Default"
msgstr "Standard"

#: res/xrc/Actions.xrc:1446
msgid ""
"Radius 10, max 10, no smoothing or clipping fix. Good starting point for "
"most outfits."
msgstr ""

#: res/xrc/Actions.xrc:1454
msgid "Even Movement"
msgstr "Glatte Bewegung"

#: res/xrc/Actions.xrc:1455
msgid ""
"Radius 5, no target limit, and No Squeeze enabled. Helps soft shapes move "
"more evenly without pulling across the center line."
msgstr ""

#: res/xrc/Actions.xrc:1463
msgid "Smooth Clipping"
msgstr ""

#: res/xrc/Actions.xrc:1464
msgid ""
"Even Movement plus smoothing and clipping fix. Useful when conforming "
"creates noisy deltas or small intersections."
msgstr ""

#: res/xrc/Actions.xrc:1470
msgid "Solid Object"
msgstr "Festes Objekt"

#: res/xrc/Actions.xrc:1471
msgid ""
"No target limit and Solid Mode enabled. Useful for rigid meshes that should "
"move as one piece."
msgstr ""

#: res/xrc/Actions.xrc:1504
msgid "Merge Geometry"
msgstr "Geometrie zusammenführen"

#: res/xrc/Actions.xrc:1513
msgid ""
"This function copies vertices and triangles from one shape to another.  "
"Partitions/segments of source and target shapes must match.  It is the "
"user's responsibility to check that all other shape and shader properties "
"are compatible, or merging will likely have side effects."
