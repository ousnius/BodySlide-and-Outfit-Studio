										</object>
										<object class="sizeritem">
											<option>0</option>
											<flag>wxRIGHT</flag>
											<border>5</border>
											<object class="wxCheckBox" name="checkAnySlider">
												<label></label>
												<style>wxCHK_3STATE</style>
												<checked>0</checked>
											</object>
										</object>
										<object class="sizeritem">
											<option>0</option>
											<flag>wxLEFT|wxRIGHT</flag>
											<border>5</border>
											<object class="wxStaticText" name="anySliderLabel">
