	<object class="wxDialog" name="dlgConforming">
		<style>wxCAPTION|wxDEFAULT_DIALOG_STYLE</style>
		<size>600,570</size>
		<title>Conforming...</title>
		<centered>1</centered>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>10</border>
				<object class="wxStaticText" name="conformingDescription">
					<label>Use Default or pick a preset, then adjust only what needs a different result. Hover options for details; some meshes still need manual cleanup.</label>
					<wrap>550</wrap>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
				<border>8</border>
				<object class="wxStaticBoxSizer">
					<orient>wxVERTICAL</orient>
					<label>Search</label>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
						<border>6</border>
						<object class="wxStaticText">
							<label>Higher values blend more vertices; lower values stay more local.</label>
							<wrap>550</wrap>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND|wxALL</flag>
						<border>6</border>
						<object class="wxFlexGridSizer">
							<rows>0</rows>
							<cols>3</cols>
							<vgap>5</vgap>
							<hgap>8</hgap>
							<growablecols>1</growablecols>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="proximityRadiusLabel">
									<label>Radius</label>
									<tooltip>Distance around each outfit vertex to search for reference vertices. Larger values find more matches but can cross into nearby unrelated geometry.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxEXPAND|wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxSlider" name="proximityRadiusSlider">
									<value translate="0">10000</value>
									<min>0</min>
									<max>20000</max>
									<size>400,-1</size>
									<tooltip>Distance around each outfit vertex to search for reference vertices. Larger values find more matches but can cross into nearby unrelated geometry.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxTextCtrl" name="proximityRadiusText">
									<size>70,-1</size>
									<value translate="0">10.00000</value>
									<tooltip>Distance around each outfit vertex to search for reference vertices. Larger values find more matches but can cross into nearby unrelated geometry.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="maxResultsLabel">
									<label>Max Targets</label>
									<tooltip>Limits how many nearby reference vertices are blended for each outfit vertex. Lower values favor closest matches; higher values average more movement.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxEXPAND|wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxSlider" name="maxResultsSlider">
									<value translate="0">10</value>
									<min>1</min>
									<max>100</max>
									<size>400,-1</size>
									<tooltip>Limits how many nearby reference vertices are blended for each outfit vertex. Lower values favor closest matches; higher values average more movement.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxTextCtrl" name="maxResultsText">
									<size>70,-1</size>
									<value translate="0">10</value>
									<tooltip>Limits how many nearby reference vertices are blended for each outfit vertex. Lower values favor closest matches; higher values average more movement.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="noTargetLimitLabel">
									<label>No Target Limit</label>
									<tooltip>Uses every matching reference vertex inside the search radius and disables Max Vertex Targets. Turning this on sets the radius to 5.0.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxCheckBox" name="noTargetLimit">
									<checked>0</checked>
									<tooltip>Uses every matching reference vertex inside the search radius and disables Max Vertex Targets. Turning this on sets the radius to 5.0.</tooltip>
								</object>
							</object>
							<object class="spacer">
								<size>0,0</size>
							</object>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
				<border>8</border>
				<object class="wxStaticBoxSizer">
					<orient>wxVERTICAL</orient>
					<label>Delta Smoothing</label>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
						<border>6</border>
						<object class="wxStaticText">
							<label>Softens jagged slider deltas after conforming.</label>
							<wrap>550</wrap>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND|wxALL</flag>
						<border>6</border>
						<object class="wxFlexGridSizer">
							<rows>0</rows>
							<cols>2</cols>
							<vgap>5</vgap>
							<hgap>8</hgap>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="smoothResultsLabel">
									<label>Smooth Deltas</label>
									<tooltip>Runs a smoothing pass on the conformed slider data before it is saved to the outfit shape.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxCheckBox" name="smoothResults">
									<checked>0</checked>
									<tooltip>Runs a smoothing pass on the conformed slider data before it is saved to the outfit shape.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="smoothIterationsLabel">
									<label>Iterations</label>
									<tooltip>Number of smoothing passes. More passes spread movement farther and make the result softer.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxTextCtrl" name="smoothIterationsText">
									<size>70,-1</size>
									<value translate="0">2</value>
									<tooltip>Number of smoothing passes. More passes spread movement farther and make the result softer.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="smoothStrengthLabel">
									<label>Strength (0-1)</label>
									<tooltip>Blend amount for each smoothing pass. 0 leaves the deltas unchanged; 1 applies the strongest smoothing.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxTextCtrl" name="smoothStrengthText">
									<size>70,-1</size>
									<value translate="0">0.50000</value>
									<tooltip>Blend amount for each smoothing pass. 0 leaves the deltas unchanged; 1 applies the strongest smoothing.</tooltip>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
				<border>8</border>
				<object class="wxStaticBoxSizer">
					<orient>wxVERTICAL</orient>
					<label>Clipping Fix</label>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
						<border>6</border>
						<object class="wxStaticText">
							<label>Reduces intersections in the new slider deltas.</label>
							<wrap>550</wrap>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND|wxALL</flag>
						<border>6</border>
						<object class="wxFlexGridSizer">
							<rows>0</rows>
							<cols>2</cols>
							<vgap>5</vgap>
							<hgap>8</hgap>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="fixClippingLabel">
									<label>Fix Clipping</label>
									<tooltip>After each slider is conformed, adjust the result to reduce intersections with the reference shape.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxCheckBox" name="fixClipping">
									<checked>0</checked>
									<tooltip>After each slider is conformed, adjust the result to reduce intersections with the reference shape.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="fixClippingStrengthLabel">
									<label>Strength (%)</label>
									<tooltip>How strongly to apply the clipping correction. Higher values push more of the correction into the conformed slider.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxTextCtrl" name="fixClippingStrengthText">
									<size>70,-1</size>
									<value translate="0">50</value>
									<enabled>0</enabled>
									<tooltip>How strongly to apply the clipping correction. Higher values push more of the correction into the conformed slider.</tooltip>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
				<border>8</border>
				<object class="wxStaticBoxSizer">
					<orient>wxVERTICAL</orient>
					<label>Shape Movement</label>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND|wxLEFT|wxRIGHT|wxTOP</flag>
						<border>6</border>
						<object class="wxStaticText">
							<label>Useful for rigid shapes or limiting movement axes.</label>
							<wrap>550</wrap>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND|wxALL</flag>
						<border>6</border>
						<object class="wxFlexGridSizer">
							<rows>0</rows>
							<cols>2</cols>
							<vgap>5</vgap>
							<hgap>8</hgap>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="noSqueezeLabel">
									<label>No X Squeeze</label>
									<tooltip>Only copies X movement that stays on the same side of the reference. Helps avoid left/right squeezing across the center line.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxCheckBox" name="noSqueeze">
									<checked>0</checked>
									<tooltip>Only copies X movement that stays on the same side of the reference. Helps avoid left/right squeezing across the center line.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="solidModeLabel">
									<label>Solid Mode</label>
									<tooltip>Uses one combined movement for the entire shape instead of separate per-vertex movement. Useful for rigid accessories or solid objects.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxCheckBox" name="solidMode">
									<checked>0</checked>
									<tooltip>Uses one combined movement for the entire shape instead of separate per-vertex movement. Useful for rigid accessories or solid objects.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxStaticText" name="axisLabel">
									<label>Axes</label>
									<tooltip>Choose which axes are allowed to receive copied movement. Unchecked axes keep their existing slider movement.</tooltip>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxALIGN_CENTER_VERTICAL</flag>
								<object class="wxBoxSizer">
									<orient>wxHORIZONTAL</orient>
									<object class="sizeritem">
										<flag>wxRIGHT</flag>
										<border>8</border>
										<object class="wxCheckBox" name="axisX">
											<label translate="0">X</label>
											<checked>1</checked>
											<tooltip>Allow conforming to write X-axis movement.</tooltip>
										</object>
									</object>
									<object class="sizeritem">
										<flag>wxRIGHT</flag>
										<border>8</border>
										<object class="wxCheckBox" name="axisY">
											<label translate="0">Y</label>
											<checked>1</checked>
											<tooltip>Allow conforming to write Y-axis movement.</tooltip>
										</object>
									</object>
									<object class="sizeritem">
										<object class="wxCheckBox" name="axisZ">
											<label translate="0">Z</label>
											<checked>1</checked>
											<tooltip>Allow conforming to write Z-axis movement.</tooltip>
										</object>
									</object>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxLEFT|wxRIGHT|wxBOTTOM</flag>
				<border>8</border>
				<object class="wxStaticBoxSizer">
					<orient>wxVERTICAL</orient>
					<label>Presets</label>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxLEFT|wxBOTTOM</flag>
						<border>5</border>
						<object class="wxBoxSizer">
							<orient>wxHORIZONTAL</orient>
							<object class="sizeritem">
								<flag>wxRIGHT</flag>
								<border>6</border>
								<object class="wxButton" name="presetDefault">
									<size>-1,25</size>
									<label>Default</label>
									<tooltip>Radius 10, max 10, no smoothing or clipping fix. Good starting point for most outfits.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxRIGHT</flag>
								<border>6</border>
								<object class="wxButton" name="presetEvenMovement">
									<size>-1,25</size>
									<label>Even Movement</label>
									<tooltip>Radius 5, no target limit, and No Squeeze enabled. Helps soft shapes move more evenly without pulling across the center line.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<flag>wxRIGHT</flag>
								<border>6</border>
								<object class="wxButton" name="presetSmoothClipping">
									<size>-1,25</size>
									<label>Smooth Clipping</label>
									<tooltip>Even Movement plus smoothing and clipping fix. Useful when conforming creates noisy deltas or small intersections.</tooltip>
								</object>
							</object>
							<object class="sizeritem">
								<object class="wxButton" name="presetSolidObject">
									<size>-1,25</size>
									<label>Solid Object</label>
									<tooltip>No target limit and Solid Mode enabled. Useful for rigid meshes that should move as one piece.</tooltip>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxALL</flag>
				<border>5</border>
				<object class="wxStdDialogButtonSizer">
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_OK">
							<label>&amp;OK</label>
						</object>
					</object>
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_CANCEL">
							<label>&amp;Cancel</label>
						</object>
					</object>
				</object>
			</object>
		</object>
	</object>
	<object class="wxDialog" name="dlgCopyGeometry">
		<style>wxCAPTION|wxDEFAULT_DIALOG_STYLE</style>
		<size>414,169</size>
		<title>Merge Geometry</title>
		<centered>1</centered>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>10</border>
				<object class="wxStaticText" name="copyGeometryDescription">
					<label>This function copies vertices and triangles from one shape to another.  Partitions/segments of source and target shapes must match.  It is the user's responsibility to check that all other shape and shader properties are compatible, or merging will likely have side effects.</label>
					<wrap>550</wrap>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxALL</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxHORIZONTAL</orient>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALIGN_CENTER_VERTICAL|wxALIGN_RIGHT|wxALL</flag>
						<border>5</border>
						<object class="wxStaticText" name="sourceLabel">
							<label>Source</label>
							<wrap>-1</wrap>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALIGN_CENTER_VERTICAL|wxALIGN_RIGHT|wxALL</flag>
						<border>5</border>
						<object class="wxChoice" name="sourceChoice">
							<selection>0</selection>
							<content />
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALIGN_CENTER_VERTICAL|wxALIGN_RIGHT|wxALL</flag>
						<border>5</border>
						<object class="wxStaticText" name="targetLabel">
							<label>Target</label>
							<wrap>-1</wrap>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALIGN_CENTER_VERTICAL|wxALIGN_RIGHT|wxALL</flag>
						<border>5</border>
						<object class="wxChoice" name="targetChoice">
							<selection>0</selection>
							<content />
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>10</border>
				<object class="wxStaticText" name="copyGeometryErrors">
					<label></label>
					<wrap>550</wrap>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL</flag>
				<border>5</border>
				<object class="wxCheckBox" name="checkDeleteSource">
					<label>Delete source shape</label>
					<checked>1</checked>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxALL</flag>
				<border>5</border>
				<object class="wxStdDialogButtonSizer">
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_OK">
							<label>&amp;OK</label>
						</object>
					</object>
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_CANCEL">
							<label>&amp;Cancel</label>
						</object>
					</object>
				</object>
			</object>
		</object>
	</object>
	<object class="wxDialog" name="dlgVertexAsym">
		<style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER</style>
		<size>423,155</size>
		<title>Mask symmetric vertices</title>
		<centered>1</centered>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
				<object class="wxStaticText" name="maskSymmetricVerticesDescription">
					<label>Masks all vertices that do not have any of the selected asymmetries.</label>
					<wrap>600</wrap>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxALL</flag>
				<border>5</border>
				<object class="wxFlexGridSizer">
					<rows>0</rows>
					<cols>3</cols>
					<vgap>0</vgap>
					<hgap>0</hgap>
					<growablecols>1</growablecols>
					<growablerows></growablerows>
					<object class="spacer">
						<option>0</option>
						<flag>wxLEFT|wxRIGHT</flag>
						<border>5</border>
						<size>0,0</size>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxLEFT|wxRIGHT</flag>
						<border>5</border>
						<object class="wxStaticText" name="currentUnmaskedLabel">
							<label>Vertices currently unmasked:</label>
							<wrap>-1</wrap>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxLEFT|wxRIGHT|wxALIGN_RIGHT</flag>
						<border>5</border>
						<object class="wxStaticText" name="currentUnmaskedText">
							<label translate="0">0</label>
							<wrap>-1</wrap>
							<style>wxALIGN_RIGHT</style>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxRIGHT</flag>
						<border>5</border>
						<object class="wxCheckBox" name="checkUnmatched">
							<label></label>
							<checked>0</checked>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxLEFT|wxRIGHT</flag>
						<border>5</border>
						<object class="wxStaticText" name="unmatchedVerticesLabel">
							<label>Unmatched Vertices:</label>
							<wrap>-1</wrap>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxLEFT|wxRIGHT|wxALIGN_RIGHT</flag>
						<border>5</border>
						<object class="wxStaticText" name="unmatchedVerticesText">
							<label translate="0">0</label>
							<wrap>-1</wrap>
							<style>wxALIGN_RIGHT</style>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxALL</flag>
				<border>5</border>
				<object class="wxStaticBoxSizer">
					<orient>wxVERTICAL</orient>
					<label>Vertex Data Asymmetries</label>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND|wxALL</flag>
						<border>5</border>
