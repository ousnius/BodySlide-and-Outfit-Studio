										<growablecols>1</growablecols>
										<growablerows></growablerows>
										<object class="spacer">
											<option>0</option>
											<flag>wxRIGHT</flag>
											<border>0</border>
											<size>0,0</size>
										</object>
										<object class="sizeritem">
											<option>0</option>
											<flag>wxLEFT|wxRIGHT</flag>
											<border>5</border>
											<object class="wxStaticText" name="typeHeading">
												<label>Type</label>
												<wrap>-1</wrap>
											</object>
										</object>
										<object class="sizeritem">
											<option>0</option>
											<flag>wxRIGHT</flag>
											<border>20</border>
											<object class="wxStaticText" name="avgHeading">
												<label>Average</label>
												<wrap>-1</wrap>
											</object>
										</object>
										<object class="sizeritem">
											<option>0</option>
											<flag>wxLEFT|wxRIGHT</flag>
											<border>5</border>
											<object class="wxStaticText" name="countHeading">
												<label>Count</label>
												<wrap>-1</wrap>
											</object>
										</object>
										<object class="sizeritem">
											<option>0</option>
											<flag>wxRIGHT</flag>
											<border>5</border>
											<object class="wxCheckBox" name="checkPosition">
												<label></label>
												<checked>0</checked>
											</object>
										</object>
										<object class="sizeritem">
											<option>0</option>
											<flag>wxLEFT|wxRIGHT</flag>
											<border>5</border>
											<object class="wxStaticText" name="positionLabel">
												<label>Position</label>
												<wrap>-1</wrap>
											</object>
										</object>
										<object class="sizeritem">
											<option>0</option>
											<flag>wxRIGHT|wxALIGN_RIGHT</flag>
											<border>20</border>
											<object class="wxStaticText" name="posAvgText">
												<label translate="0">0</label>
												<wrap>-1</wrap>
												<style>wxALIGN_RIGHT</style>
											</object>
										</object>
										<object class="sizeritem">
											<option>0</option>
											<flag>wxLEFT|wxRIGHT|wxALIGN_RIGHT</flag>
											<border>5</border>
