							</object>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxHORIZONTAL</orient>
					<object class="sizeritem">
						<option>1</option>
						<flag>wxLEFT|wxRIGHT</flag>
						<border>5</border>
						<object class="wxStaticText" name="stillUnmaskedLabel">
							<label>Vertices that will still be unmasked:</label>
							<wrap>-1</wrap>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxLEFT|wxRIGHT|wxALIGN_RIGHT</flag>
						<border>5</border>
						<minsize>100,20</minsize>
						<object class="wxStaticText" name="stillUnmaskedText">
							<label translate="0">0</label>
							<wrap>-1</wrap>
							<style>wxALIGN_RIGHT</style>
