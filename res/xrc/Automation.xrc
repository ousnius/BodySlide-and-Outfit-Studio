																	<checked>1</checked>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxTOP</flag>
																<border>3</border>
																<object class="wxCheckBox" name="chkSymVertUnmatched">
																	<label>Unmatched vertices</label>
