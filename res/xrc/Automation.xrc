															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- TransformShape -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageTransformShape">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Transform Shape</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>4</cols>
															<vgap>5</vgap>
															<hgap>5</hgap>
															<growablecols>1,2,3</growablecols>

