																		<hint>Find text</hint>
																	</object>
																</object>

																<object class="sizeritem">
																	<flag>wxALIGN_CENTER_VERTICAL</flag>
																	<object class="wxStaticText">
																		<label>Replace (to):</label>
																	</object>
																</object>
																<object class="sizeritem">
																	<flag>wxEXPAND</flag>
																	<object class="wxTextCtrl" name="txtSaveReplaceTo">
																		<tooltip>Replacement text for matching text in original project fields (batch only)</tooltip>
																		<hint>Replace with</hint>
																	</object>
																</object>

																<object class="sizeritem">
																	<flag>wxALIGN_CENTER_VERTICAL</flag>
																	<object class="wxStaticText">
