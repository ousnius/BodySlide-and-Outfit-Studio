																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxFilePickerCtrl" name="fpRefSourceFile">
																	<message>Select reference file</message>
																	<wildcard>Slider Set Files (*.osp;*.xml)|*.osp;*.xml|NIF Files (*.nif)|*.nif|All Files (*.*)|*.*</wildcard>
																	<style>wxFLP_DEFAULT_STYLE|wxFLP_USE_TEXTCTRL</style>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Slider Set:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxChoice" name="choiceRefSet">
