										<!-- ResetTransforms -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageResetTransforms">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Reset Transforms</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL</flag>
														<border>5</border>
