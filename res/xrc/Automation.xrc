																				<checked>1</checked>
																			</object>
																		</object>
																	</object>
																</object>
															</object>
														</object>
													</object>

													<object class="sizeritem">
														<option>0</option>
														<flag>wxLEFT|wxRIGHT|wxBOTTOM|wxEXPAND</flag>
														<border>5</border>
														<object class="wxPanel" name="panelSaveBatchFields">
															<object class="wxFlexGridSizer">
																<cols>2</cols>
																<vgap>5</vgap>
																<hgap>10</hgap>
																<growablecols>1</growablecols>

																<object class="sizeritem">
																	<flag>wxALIGN_CENTER_VERTICAL</flag>
																	<object class="wxStaticText">
																		<label>Replace (from):</label>
																	</object>
																</object>
																<object class="sizeritem">
																	<flag>wxEXPAND</flag>
																	<object class="wxTextCtrl" name="txtSaveReplaceFrom">
