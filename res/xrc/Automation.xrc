<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
	<object class="wxDialog" name="dlgAutomation">
		<style>wxDEFAULT_DIALOG_STYLE|wxRESIZE_BORDER|wxMAXIMIZE_BOX</style>
		<title>Automation Script</title>
		<centered>1</centered>
		<size>900,650</size>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>

			<!-- Toolbar -->
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxHORIZONTAL</orient>
					<object class="sizeritem">
						<flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
						<border>5</border>
						<object class="wxStaticText">
							<label>Automation:</label>
						</object>
					</object>
					<object class="sizeritem">
						<option>1</option>
						<flag>wxEXPAND|wxRIGHT</flag>
						<border>5</border>
						<object class="wxComboBox" name="cmbAutomation">
							<tooltip>Select an automation to load, or type a name for a new one</tooltip>
							<hint>Automation name...</hint>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxRIGHT</flag>
						<border>5</border>
						<object class="wxButton" name="btnSaveScript">
							<label>Save</label>
							<tooltip>Save the automation script</tooltip>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxRIGHT</flag>
						<border>5</border>
						<object class="wxButton" name="btnDeleteScript">
							<label>Delete</label>
							<tooltip>Delete the current automation script</tooltip>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxRIGHT</flag>
						<border>5</border>
						<object class="wxButton" name="btnOpenFolder">
							<label>Open Folder</label>
							<tooltip>Open the Automations folder in file explorer</tooltip>
						</object>
					</object>
				</object>
			</object>

			<!-- Main splitter area -->
			<object class="sizeritem">
				<option>1</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxHORIZONTAL</orient>

					<!-- Left: Step list -->
					<object class="sizeritem">
						<option>1</option>
						<flag>wxRIGHT|wxEXPAND</flag>
						<border>5</border>
						<object class="wxListCtrl" name="listSteps">
							<style>wxLC_REPORT|wxLC_SINGLE_SEL</style>
							<size>350,-1</size>
						</object>
					</object>

					<!-- Right: Step details -->
					<object class="sizeritem">
						<option>2</option>
						<flag>wxEXPAND</flag>
						<border>0</border>
						<object class="wxPanel" name="panelStepSettings">
							<object class="wxBoxSizer">
								<orient>wxVERTICAL</orient>

								<!-- Common fields -->
								<object class="sizeritem">
									<option>0</option>
									<flag>wxBOTTOM|wxEXPAND</flag>
									<border>5</border>
									<object class="wxStaticBoxSizer">
										<orient>wxVERTICAL</orient>
										<label>Step Settings</label>

										<object class="sizeritem">
											<option>0</option>
											<flag>wxALL|wxEXPAND</flag>
											<border>3</border>
											<object class="wxFlexGridSizer">
												<cols>2</cols>
												<vgap>5</vgap>
												<hgap>10</hgap>
												<growablecols>1</growablecols>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>Type:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxComboCtrl" name="comboStepType">
														<style>wxCB_READONLY</style>
														<tooltip>Pick the operation this step performs. The types are grouped by category and the popup can be filtered by typing.</tooltip>
													</object>
												</object>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>Active:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxCheckBox" name="chkActive">
														<label>Execute this step</label>
														<checked>1</checked>
													</object>
												</object>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>Target Shapes:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxBoxSizer">
														<orient>wxHORIZONTAL</orient>
														<object class="sizeritem">
															<option>1</option>
															<flag>wxEXPAND|wxRIGHT</flag>
															<border>5</border>
															<object class="wxTextCtrl" name="txtTargetMeshes">
																<tooltip>Comma-separated list of shape names. Leave empty to target all shapes, or the root node for extra data steps.</tooltip>
																<hint>Comma-separated shape list</hint>
															</object>
														</object>
														<object class="sizeritem">
															<flag>wxALIGN_CENTER_VERTICAL|wxRIGHT</flag>
															<border>5</border>
															<object class="wxButton" name="btnAddTargetMesh">
																<label translate="0">+</label>
																<size>24,-1</size>
																<tooltip>Add shapes from list</tooltip>
															</object>
														</object>
														<object class="sizeritem">
															<flag>wxALIGN_CENTER_VERTICAL</flag>
															<object class="wxCheckBox" name="chkTargetRegex">
																<label>Regex</label>
																<tooltip>Use regex matching for target shape names</tooltip>
															</object>
														</object>
													</object>
												</object>

												<object class="sizeritem">
													<flag>wxALIGN_TOP</flag>
													<object class="wxStaticText">
														<label>Note:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxTextCtrl" name="txtNote">
														<style>wxTE_MULTILINE</style>
														<size>-1,50</size>
														<tooltip>A note to describe what this step does and how to configure it.</tooltip>
														<hint>Description of this step...</hint>
													</object>
												</object>
											</object>
										</object>
									</object>
								</object>

								<!-- Type-specific panels in a simplebook -->
								<object class="sizeritem">
									<option>1</option>
									<flag>wxEXPAND</flag>
									<border>0</border>
									<object class="wxSimplebook" name="bookStepPages">

										<!-- AddCustomBone -->
										<object class="simplebookpage">
											<selected>1</selected>
											<object class="wxPanel" name="pageAddCustomBone">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Add Custom Bone</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Bone Name:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtAddBoneName">
																	<hint>Bone name</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Parent Bone:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtAddBoneParent">
																	<tooltip>Name of the parent bone (leave empty for no parent)</tooltip>
																	<hint>Parent bone name</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Translation:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxHORIZONTAL</orient>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxRIGHT</flag>
																		<border>3</border>
																		<object class="wxTextCtrl" name="txtAddBoneTransX">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">X</tooltip>
																			<hint translate="0">X</hint>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxRIGHT</flag>
																		<border>3</border>
																		<object class="wxTextCtrl" name="txtAddBoneTransY">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">Y</tooltip>
																			<hint translate="0">Y</hint>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<option>1</option>
																		<object class="wxTextCtrl" name="txtAddBoneTransZ">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">Z</tooltip>
																			<hint translate="0">Z</hint>
																		</object>
																	</object>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Rotation:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxHORIZONTAL</orient>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxRIGHT</flag>
																		<border>3</border>
																		<object class="wxTextCtrl" name="txtAddBoneRotX">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">X</tooltip>
																			<hint translate="0">X</hint>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxRIGHT</flag>
																		<border>3</border>
																		<object class="wxTextCtrl" name="txtAddBoneRotY">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">Y</tooltip>
																			<hint translate="0">Y</hint>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<option>1</option>
																		<object class="wxTextCtrl" name="txtAddBoneRotZ">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">Z</tooltip>
																			<hint translate="0">Z</hint>
																		</object>
																	</object>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- CopyBoneWeights -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageCopyBoneWeights">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Copy Bone Weights</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Proximity Radius:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtWeightRadius">
																	<value translate="0">10.0</value>
																	<hint translate="0">10.0</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Max Results:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtWeightMaxResults">
																	<value translate="0">10</value>
																	<hint translate="0">10</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_TOP</flag>
																<object class="wxStaticText">
																	<label>Bone List:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtWeightBoneList">
																	<tooltip>Comma-separated list of bone names. Leave empty to copy all bones.</tooltip>
																	<hint>Comma-separated bone list</hint>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- DeleteBones -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageDeleteBones">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Delete Bones</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Bone Names:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtDeleteBoneNames">
																	<tooltip>Comma-separated list of bone names to delete</tooltip>
																	<hint>Comma-separated bone list</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Mode:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxCheckBox" name="chkDeleteBoneFromProject">
																	<label>Delete bone entirely from project</label>
																	<checked>1</checked>
																	<tooltip>If checked, deletes the bone from all shapes and the NIF. If unchecked, only removes bone weights from target shapes.</tooltip>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- EditBone -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageEditBone">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Edit Bone</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Bone Name:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtEditBoneName">
																	<tooltip>Name of the custom bone to edit</tooltip>
																	<hint>Bone name</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Parent Bone:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtEditBoneParent">
																	<tooltip>Name of the parent bone (leave empty for no parent)</tooltip>
																	<hint>Parent bone name</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Translation:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxHORIZONTAL</orient>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxRIGHT</flag>
																		<border>3</border>
																		<object class="wxTextCtrl" name="txtEditBoneTransX">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">X</tooltip>
																			<hint translate="0">X</hint>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxRIGHT</flag>
																		<border>3</border>
																		<object class="wxTextCtrl" name="txtEditBoneTransY">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">Y</tooltip>
																			<hint translate="0">Y</hint>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<option>1</option>
																		<object class="wxTextCtrl" name="txtEditBoneTransZ">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">Z</tooltip>
																			<hint translate="0">Z</hint>
																		</object>
																	</object>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Rotation:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxHORIZONTAL</orient>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxRIGHT</flag>
																		<border>3</border>
																		<object class="wxTextCtrl" name="txtEditBoneRotX">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">X</tooltip>
																			<hint translate="0">X</hint>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxRIGHT</flag>
																		<border>3</border>
																		<object class="wxTextCtrl" name="txtEditBoneRotY">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">Y</tooltip>
																			<hint translate="0">Y</hint>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<option>1</option>
																		<object class="wxTextCtrl" name="txtEditBoneRotZ">
																			<value translate="0">0.0</value>
																			<tooltip translate="0">Z</tooltip>
																			<hint translate="0">Z</hint>
																		</object>
																	</object>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- RemoveSkinning -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageRemoveSkinning">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Remove Skinning</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Removes skinning from target shapes (or all shapes if Target Shapes is empty).
																This deletes all bone weights and skinning data from the shapes.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- ExportFile -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageExportFile">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Export File</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText" name="lblExportPath">
																	<label>Export File Path:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxVERTICAL</orient>
																	<object class="sizeritem">
																		<flag>wxEXPAND</flag>
																		<object class="wxFilePickerCtrl" name="fpExportFile">
																			<message>Select export file path</message>
																			<wildcard>NIF Files (*.nif)|*.nif|OBJ Files (*.obj)|*.obj|FBX Files (*.fbx)|*.fbx|OSD Files (*.osd)|*.osd|TRI Files (*.tri)|*.tri|All Files (*.*)|*.*</wildcard>
																			<style>wxFLP_SAVE|wxFLP_USE_TEXTCTRL|wxFLP_OVERWRITE_PROMPT</style>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<flag>wxEXPAND</flag>
																		<object class="wxDirPickerCtrl" name="dpExportFolder">
																			<message>Select export folder</message>
																			<style>wxDIRP_USE_TEXTCTRL</style>
																		</object>
																	</object>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Options:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxVERTICAL</orient>
																	<object class="sizeritem">
																		<object class="wxCheckBox" name="chkExportUseOriginalPath">
																			<label>Use original file path from batch operation</label>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<object class="wxCheckBox" name="chkExportWithRef">
																			<label>Export with reference shape (.nif only)</label>
																			<checked>1</checked>
																		</object>
																	</object>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Filename Prefix:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtExportPrefix">
																	<tooltip>Prefix to add before the filename. Supports {{PLACEHOLDER}} variables.</tooltip>
																	<hint>e.g. prefix_</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Filename Suffix:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtExportSuffix">
																	<tooltip>Suffix to add after the filename before the extension. Supports {{PLACEHOLDER}} variables.</tooltip>
																	<hint>e.g. _suffix</hint>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- SaveProject -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageSaveProject">
