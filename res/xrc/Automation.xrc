															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxChoice" name="choiceRefSet">
																	<tooltip>Name of the slider set within the source file</tooltip>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Shape:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxChoice" name="choiceRefShape">
																	<tooltip>Name of the reference shape</tooltip>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Options:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxVERTICAL</orient>
																	<object class="sizeritem">
																		<object class="wxCheckBox" name="chkRefLoadAll">
																			<label>Load all shapes</label>
																			<checked>1</checked>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<object class="wxCheckBox" name="chkRefMergeSliders">
																			<label>Merge sliders</label>
																			<checked>1</checked>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<object class="wxCheckBox" name="chkRefMergeZaps">
																			<label>Merge zaps</label>
																			<checked>1</checked>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<object class="wxCheckBox" name="chkRefAppendNewSliders">
																			<label>Append new sliders</label>
																			<checked>1</checked>
																		</object>
																	</object>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- SetBaseShape -->
