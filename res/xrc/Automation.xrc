											</object>
										</object>

										<!-- SetSliderProperties -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageSetSliderProperties">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Set Slider Properties</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_TOP</flag>
																<object class="wxStaticText">
																	<label>Slider Names:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxHORIZONTAL</orient>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxEXPAND|wxRIGHT</flag>
																		<border>5</border>
																		<object class="wxTextCtrl" name="txtSliderPropNames">
																			<tooltip>Comma-separated list of slider names. Leave empty to apply to all sliders.</tooltip>
																			<hint>Comma-separated slider list</hint>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<flag>wxALIGN_CENTER_VERTICAL</flag>
																		<object class="wxButton" name="btnAddSliderProp">
																			<label translate="0">+</label>
																			<size>24,-1</size>
																			<tooltip>Add sliders from list</tooltip>
																		</object>
																	</object>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Zap:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxChoice" name="choiceSliderPropZap">
																	<content>
																		<item>No change</item>
																		<item>No</item>
																		<item>Yes</item>
																	</content>
																	<tooltip>Set the zap flag on matching sliders.</tooltip>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Hidden:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxChoice" name="choiceSliderPropHidden">
																	<content>
																		<item>No change</item>
																		<item>No</item>
																		<item>Yes</item>
																	</content>
																	<tooltip>Set the hidden flag on matching sliders.</tooltip>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText" name="lblSliderPropZapped">
																	<label>Default Zapped:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxChoice" name="choiceSliderPropZapped">
																	<content>
																		<item>No change</item>
																		<item>Not zapped</item>
																		<item>Zapped</item>
																	</content>
																	<tooltip>Whether matching zap sliders are zapped by default.</tooltip>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText" name="lblSliderPropDefaultLo">
																	<label>Default (Small):</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtSliderPropDefaultLo">
																	<tooltip>Default small value (0-100). Leave empty for no change.</tooltip>
																	<hint translate="0">0-100</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText" name="lblSliderPropDefaultHi">
																	<label>Default (Big):</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtSliderPropDefaultHi">
																	<tooltip>Default big value (0-100). Leave empty for no change.</tooltip>
																	<hint translate="0">0-100</hint>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- SetShaderProperties -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageSetShaderProperties">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Set Shader Properties</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Property:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxHORIZONTAL</orient>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxEXPAND|wxRIGHT</flag>
																		<border>5</border>
																		<object class="wxChoice" name="choiceShaderPropAdd">
																			<tooltip>Select a shader property to add to this step.</tooltip>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<flag>wxALIGN_CENTER_VERTICAL</flag>
																		<object class="wxButton" name="btnAddShaderProp">
																			<label>Add</label>
																			<tooltip>Add the selected shader property to this step.</tooltip>
																		</object>
																	</object>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_TOP</flag>
																<object class="wxStaticText">
																	<label>Values:</label>
																</object>
															</object>
															<object class="sizeritem">
																<option>1</option>
																<flag>wxEXPAND</flag>
																<object class="wxScrolledWindow" name="panelShaderPropRows">
																	<style>wxVSCROLL|wxTAB_TRAVERSAL</style>
																	<size>-1,220</size>
																	<object class="wxBoxSizer">
																		<orient>wxVERTICAL</orient>
																	</object>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- SetTexturePaths -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageSetTexturePaths">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Set Texture Paths</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Texture Slot:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxHORIZONTAL</orient>
																	<object class="sizeritem">
																		<option>1</option>
																		<flag>wxEXPAND|wxRIGHT</flag>
																		<border>5</border>
																		<object class="wxChoice" name="choiceTexturePathAdd">
																			<tooltip>Select a texture slot to add to this step.</tooltip>
																		</object>
																	</object>
																	<object class="sizeritem">
																		<flag>wxALIGN_CENTER_VERTICAL</flag>
																		<object class="wxButton" name="btnAddTexturePath">
																			<label>Add</label>
																			<tooltip>Add the selected texture path to this step.</tooltip>
																		</object>
																	</object>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_TOP</flag>
																<object class="wxStaticText">
																	<label>Paths:</label>
																</object>
															</object>
															<object class="sizeritem">
																<option>1</option>
																<flag>wxEXPAND</flag>
																<object class="wxScrolledWindow" name="panelTexturePathRows">
																	<style>wxVSCROLL|wxTAB_TRAVERSAL</style>
																	<size>-1,220</size>
																	<object class="wxBoxSizer">
																		<orient>wxVERTICAL</orient>
																	</object>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- ClearMask -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageClearMask">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Clear Mask</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Clears the mask for the target shape(s).</label>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- LoadMask -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageLoadMask">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Load Mask</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Mask File:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxFilePickerCtrl" name="fpLoadMaskFile">
																	<message>Select a mask XML file</message>
																	<wildcard>XML Files (*.xml)|*.xml</wildcard>
																	<style>wxFLP_OPEN|wxFLP_FILE_MUST_EXIST|wxFLP_USE_TEXTCTRL</style>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Mask Name:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxChoice" name="choiceLoadMaskName">
																	<tooltip>Select a mask entry from the loaded mask file.</tooltip>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- RemoveUnusedNodes -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageRemoveUnusedNodes">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Remove Unused Nodes</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Removes all unreferenced nodes from the NIF.</label>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- AddBone -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageAddBone">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Add Bone</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Bone Names:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtAddBoneRefNames">
																	<tooltip>Comma-separated list of bone names to add from the loaded skeleton.</tooltip>
																	<hint>Comma-separated bone list</hint>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Adds bone references from the loaded skeleton to every shape of the project, like the Add Bone dialog does.
																Bones that are not in the skeleton are skipped.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- TransferWeights -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageTransferWeights">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Transfer Selected Weights</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Bone Names:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtTransferWeightBones">
																	<tooltip>Comma-separated list of bones to transfer. Leave empty to transfer every bone of the reference shape.</tooltip>
																	<hint>Leave empty for all bones</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Mask:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxCheckBox" name="chkTransferWeightUseMask">
																	<label>Keep the weights of masked vertices</label>
																	<checked>1</checked>
																	<tooltip>Blend the transferred weights by the current mask instead of overwriting everything.</tooltip>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Copies bone weights vertex by vertex from the reference shape. The target shapes need the same vertex count as the reference.
																Leaving the target meshes empty excludes the reference shape.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- SetBoneTransform -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageSetBoneTransform">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Set Bone Transform</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Bone Names:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtBoneXformNames">
																	<tooltip>Comma-separated list of bones to recalculate.</tooltip>
																	<hint>Comma-separated bone list</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Mode:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxChoice" name="choiceBoneXformMode">
																	<content>
																		<item>Set bone as skin (skin transform from node)</item>
																		<item>Set bone as node (node transform from skin)</item>
																	</content>
																	<selection>0</selection>
																	<tooltip>Which of the two transforms is recalculated from the other one.</tooltip>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Recalculates the skin-to-bone transform of a bone from its node transform, or the other way around, for the target shapes.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- MakeConversionRef -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageMakeConversionRef">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Make Conversion Reference</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Slider Name:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtConvRefSliderName">
																	<tooltip>Name of the conversion slider to create.</tooltip>
																	<hint>ConvertToBase</hint>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Turns the current slider settings into a new conversion slider and makes the deformed reference the new base shape.
																Requires at least one non-zero slider value and deletes all other sliders of the project.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- CopySegPart -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageCopySegPart">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Copy Segments/Partitions</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Assigns every triangle of the target shapes to the segment/partition of the nearest reference triangle. Existing segments/partitions are cleared.
																Leaving the target meshes empty excludes the reference shape. No additional parameters needed.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- DeleteVertices -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageDeleteVertices">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Delete Vertices</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxBoxSizer">
															<orient>wxVERTICAL</orient>
															<object class="sizeritem">
																<object class="wxCheckBox" name="chkDeleteVertsMasked">
																	<label>Delete the masked vertices instead of the unmasked ones</label>
																	<tooltip>By default the mask protects vertices and everything else is deleted, like the menu item does.</tooltip>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxTOP</flag>
																<border>3</border>
																<object class="wxCheckBox" name="chkDeleteVertsDeleteEmpty">
																	<label>Delete shapes that lose all of their triangles</label>
																	<checked>1</checked>
																	<tooltip>Uncheck to leave such shapes untouched instead.</tooltip>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Deletes vertices and their triangles from the target shapes. Set up the mask with the Masks steps first;
																without a mask every vertex counts as unmasked.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- MergeGeometry -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageMergeGeometry">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Merge Geometry</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Source Shape:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtMergeSourceShape">
																	<tooltip>Name of the shape whose geometry is copied.</tooltip>
																	<hint>Shape name</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Target Shape:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtMergeTargetShape">
																	<tooltip>Name of the shape the geometry is merged into.</tooltip>
																	<hint>Shape name</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Source:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxCheckBox" name="chkMergeDeleteSource">
																	<label>Delete the source shape afterwards</label>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Merges the geometry of one shape into another one. The step fails if the shaders or alpha properties do not match
																or the result would exceed the vertex/triangle limits. This step uses its own shape names, not the target meshes above.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- SeparateVertices -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageSeparateVertices">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Separate Vertices</label>
