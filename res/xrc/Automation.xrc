														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Bone Names:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtMaskBoneNames">
																	<tooltip>Comma-separated list of bones whose weighted vertices are masked.</tooltip>
																	<hint>Comma-separated bone list</hint>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Replaces the mask of the target shapes with the vertices that have a weight greater than zero for any of the given bones.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- MaskSliderAffected -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageMaskSliderAffected">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Mask Slider-Affected Vertices</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Slider Name:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtMaskSliderName">
																	<tooltip>Name of the slider whose affected vertices are masked.</tooltip>
																	<hint>Slider name</hint>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Replaces the mask of the target shapes with the vertices that the given slider has morph data for.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- MaskWeighted -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageMaskWeighted">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Mask Weighted Vertices</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Replaces the mask of the target shapes with the vertices that have a weight greater than zero for any of their bones.
																No additional parameters needed.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- SaveMask -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageSaveMask">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Save Mask</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Mask File:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtSaveMaskFile">
																	<tooltip>Path of the XML mask file to write. Relative paths are resolved against the project folder.</tooltip>
																	<hint>masks.xml</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Mask Name:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtSaveMaskName">
																	<tooltip>Name of the entry inside the mask file.</tooltip>
																	<hint>Mask name</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Existing File:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxCheckBox" name="chkSaveMaskMerge">
																	<label>Keep the other entries of an existing file</label>
																	<checked>1</checked>
																	<tooltip>Uncheck to overwrite the file with just this entry.</tooltip>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Writes the current mask of the target shapes into a named entry of an XML mask file, ready to be read back by Masks: Load Mask.
																An entry of the same name is replaced.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- SetVariable -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageSetVariable">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Set Variable</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Name:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtSetVariableName">
																	<tooltip>Name of the variable, without the curly braces.</tooltip>
																	<hint>KEY</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Value:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtSetVariableValue">
																	<tooltip>Value to substitute. Placeholders of already known variables are resolved first.</tooltip>
																	<hint>Value</hint>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Defines a {{KEY}} placeholder for the steps that follow. Names that are already in the placeholder variables below
																are substituted before the run and cannot be overridden here.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- LogMessage -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageLogMessage">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Log Message</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Message:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxTextCtrl" name="txtLogMessage">
																	<tooltip>Text to write to the log. Placeholders are substituted.</tooltip>
																	<hint>Message text</hint>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Level:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxChoice" name="choiceLogMessageLevel">
																	<content>
																		<item>Message</item>
																		<item>Warning</item>
																		<item>Error</item>
																	</content>
																	<selection>0</selection>
																	<tooltip>Errors and warnings are shown in a dialog outside of headless runs, but never fail the step.</tooltip>
																</object>
															</object>
														</object>
													</object>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Writes a message to the automation log. Useful to mark sections of a long batch run or to show a resolved variable.</label>
															<wrap>400</wrap>
														</object>
													</object>
												</object>
											</object>
										</object>
									</object>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>

			<!-- Variables section -->
			<object class="sizeritem">
				<option>0</option>
				<flag>wxLEFT|wxRIGHT|wxEXPAND</flag>
				<border>5</border>
				<object class="wxCollapsiblePane" name="paneVariables">
					<label>Placeholder Variables</label>
					<object class="panewindow">
						<object class="wxBoxSizer">
							<orient>wxVERTICAL</orient>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxBOTTOM</flag>
								<border>3</border>
								<object class="wxStaticText">
									<label>Define {{KEY}} = Value pairs. These are substituted in all text fields before execution.</label>
									<wrap>500</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxEXPAND</flag>
								<border>0</border>
								<object class="wxFlexGridSizer">
									<cols>2</cols>
									<vgap>3</vgap>
									<hgap>5</hgap>
									<growablecols>1</growablecols>

									<object class="sizeritem">
										<flag>wxALIGN_CENTER_VERTICAL</flag>
										<object class="wxStaticText">
											<label>Key:</label>
										</object>
									</object>
									<object class="sizeritem">
										<flag>wxALIGN_CENTER_VERTICAL</flag>
										<object class="wxStaticText">
											<label>Value:</label>
										</object>
									</object>

									<object class="sizeritem">
										<flag>wxEXPAND</flag>
										<object class="wxTextCtrl" name="txtVarKey1">
											<hint>KEY</hint>
										</object>
									</object>
									<object class="sizeritem">
										<flag>wxEXPAND</flag>
										<object class="wxTextCtrl" name="txtVarVal1">
											<hint>Value</hint>
										</object>
									</object>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxTOP</flag>
								<border>3</border>
								<object class="wxBoxSizer">
									<orient>wxHORIZONTAL</orient>
									<object class="sizeritem">
										<object class="wxButton" name="btnAddVariable">
											<label>+ Add</label>
											<size>80,-1</size>
										</object>
									</object>
									<object class="sizeritem">
										<flag>wxLEFT</flag>
										<border>5</border>
										<object class="wxButton" name="btnRemoveVariable">
											<label>- Remove</label>
											<size>80,-1</size>
										</object>
									</object>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>

			<!-- Bottom buttons -->
			<object class="sizeritem">
				<option>0</option>
				<flag>wxLEFT|wxRIGHT|wxEXPAND</flag>
				<border>5</border>
				<object class="wxCollapsiblePane" name="paneBatch">
					<label>Batch Operation</label>
					<object class="panewindow">
						<object class="wxBoxSizer">
							<orient>wxVERTICAL</orient>

							<object class="sizeritem">
								<option>0</option>
								<flag>wxBOTTOM|wxEXPAND</flag>
								<border>5</border>
								<object class="wxRadioBox" name="radioBatchMode">
									<label>Mode</label>
									<dimension>1</dimension>
									<content>
										<item>None (run on current project)</item>
										<item>Folder scan (repeat on files in folder)</item>
										<item>Slider sets (repeat on installed slider sets)</item>
									</content>
									<selection>0</selection>
								</object>
							</object>

							<!-- Folder scan options -->
							<object class="sizeritem">
								<option>0</option>
								<flag>wxEXPAND|wxBOTTOM</flag>
								<border>5</border>
								<object class="wxPanel" name="panelBatchFolder">
									<object class="wxStaticBoxSizer" name="boxBatchFolder">
										<orient>wxVERTICAL</orient>
										<label>Folder Scan Settings</label>
										<object class="sizeritem">
											<flag>wxALL|wxEXPAND</flag>
											<border>3</border>
											<object class="wxFlexGridSizer">
												<cols>2</cols>
												<vgap>5</vgap>
												<hgap>10</hgap>
												<growablecols>1</growablecols>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>Folder:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxDirPickerCtrl" name="dpBatchFolder">
														<message>Select folder to scan</message>
														<style>wxDIRP_DEFAULT_STYLE|wxDIRP_USE_TEXTCTRL</style>
													</object>
												</object>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>File Extension:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxTextCtrl" name="txtBatchExtension">
														<value translate="0">.nif</value>
														<tooltip>File extension to scan for (e.g. .nif, .obj)</tooltip>
													</object>
												</object>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>Options:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxCheckBox" name="chkBatchSubdirs">
														<label>Include subdirectories</label>
													</object>
												</object>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>File Filter:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxBoxSizer">
														<orient>wxHORIZONTAL</orient>
														<object class="sizeritem">
															<option>1</option>
															<flag>wxEXPAND|wxRIGHT</flag>
															<border>5</border>
															<object class="wxTextCtrl" name="txtBatchFileFilter">
																<tooltip>Filter file/folder names (substring or regex)</tooltip>
																<hint>Filter pattern...</hint>
															</object>
														</object>
														<object class="sizeritem">
															<flag>wxALIGN_CENTER_VERTICAL</flag>
															<object class="wxCheckBox" name="chkBatchFileFilterRegex">
																<label>Regex</label>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>
									</object>
								</object>
							</object>

							<!-- Slider set batch options -->
							<object class="sizeritem">
								<option>0</option>
								<flag>wxEXPAND</flag>
								<border>0</border>
								<object class="wxPanel" name="panelBatchSliderSets">
									<object class="wxStaticBoxSizer" name="boxBatchSliderSets">
										<orient>wxVERTICAL</orient>
										<label>Slider Set Settings</label>
										<object class="sizeritem">
											<flag>wxALL|wxEXPAND</flag>
											<border>3</border>
											<object class="wxFlexGridSizer">
												<cols>2</cols>
												<vgap>5</vgap>
												<hgap>10</hgap>
												<growablecols>1</growablecols>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>Filter:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxBoxSizer">
														<orient>wxHORIZONTAL</orient>
														<object class="sizeritem">
															<option>1</option>
															<flag>wxEXPAND|wxRIGHT</flag>
															<border>5</border>
															<object class="wxTextCtrl" name="txtBatchSliderSetFilter">
																<tooltip>Filter slider set names (substring or regex). Leave empty for all.</tooltip>
																<hint>Filter pattern...</hint>
															</object>
														</object>
														<object class="sizeritem">
															<flag>wxALIGN_CENTER_VERTICAL</flag>
															<object class="wxCheckBox" name="chkBatchSliderSetFilterRegex">
																<label>Regex</label>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- RefineMesh -->

									</object>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>

			<!-- Output log -->
			<object class="sizeritem">
				<option>0</option>
				<flag>wxLEFT|wxRIGHT|wxEXPAND</flag>
				<border>5</border>
				<object class="wxCollapsiblePane" name="paneOutput">
					<label>Output Log</label>
					<collapsed>1</collapsed>
				</object>
			</object>

			<!-- Execute buttons -->
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxHORIZONTAL</orient>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxRIGHT</flag>
						<border>5</border>
						<object class="wxButton" name="btnExecuteAll">
							<label>Execute</label>
							<tooltip>Execute all active steps in order</tooltip>
						</object>
					</object>
					<object class="spacer">
						<option>1</option>
						<flag>wxEXPAND</flag>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<object class="wxButton" name="wxID_CLOSE">
							<label>Close</label>
						</object>
					</object>
				</object>
			</object>

		</object>
	</object>
</resource>
