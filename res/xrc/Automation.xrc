															<orient>wxHORIZONTAL</orient>
															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxCheckBox" name="chkSaveCopyRefFromProject">
																	<label>Copy reference based on loaded project</label>
