																	</object>
																</object>
																<object class="sizeritem">
																	<flag>wxEXPAND</flag>
																	<object class="wxTextCtrl" name="txtSaveSuffix">
																				<tooltip>Suffix to append to Display Name, Shape Data Folder, and Slider Set file name (batch only)</tooltip>
																		<hint>e.g. _modified</hint>
																	</object>
																</object>
															</object>
														</object>
													</object>

													<object class="sizeritem">
