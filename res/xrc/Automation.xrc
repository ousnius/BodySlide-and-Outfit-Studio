										<object class="simplebookpage">
											<object class="wxPanel" name="pageLoadMask">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Load Mask</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL|wxEXPAND</flag>
														<border>5</border>
														<object class="wxFlexGridSizer">
															<cols>2</cols>
															<vgap>5</vgap>
															<hgap>10</hgap>
															<growablecols>1</growablecols>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Mask File:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxFilePickerCtrl" name="fpLoadMaskFile">
																	<message>Select a mask XML file</message>
																	<wildcard>XML Files (*.xml)|*.xml</wildcard>
																	<style>wxFLP_OPEN|wxFLP_FILE_MUST_EXIST|wxFLP_USE_TEXTCTRL</style>
																</object>
															</object>

															<object class="sizeritem">
																<flag>wxALIGN_CENTER_VERTICAL</flag>
																<object class="wxStaticText">
																	<label>Mask Name:</label>
																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxChoice" name="choiceLoadMaskName">
																	<tooltip>Select a mask entry from the loaded mask file.</tooltip>
																</object>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- RemoveUnusedNodes -->
										<object class="simplebookpage">
											<object class="wxPanel" name="pageRemoveUnusedNodes">
												<object class="wxStaticBoxSizer">
													<orient>wxVERTICAL</orient>
													<label>Remove Unused Nodes</label>
													<object class="sizeritem">
														<option>0</option>
														<flag>wxALL</flag>
														<border>5</border>
														<object class="wxStaticText">
															<label>Removes all unreferenced nodes from the NIF.</label>
														</object>
													</object>
												</object>
											</object>
										</object>
									</object>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>

			<!-- Variables section -->
			<object class="sizeritem">
				<option>0</option>
				<flag>wxLEFT|wxRIGHT|wxEXPAND</flag>
				<border>5</border>
				<object class="wxCollapsiblePane" name="paneVariables">
					<label>Placeholder Variables</label>
					<object class="panewindow">
						<object class="wxBoxSizer">
							<orient>wxVERTICAL</orient>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxBOTTOM</flag>
								<border>3</border>
								<object class="wxStaticText">
									<label>Define {{KEY}} = Value pairs. These are substituted in all text fields before execution.</label>
									<wrap>500</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxEXPAND</flag>
								<border>0</border>
								<object class="wxFlexGridSizer">
									<cols>2</cols>
									<vgap>3</vgap>
									<hgap>5</hgap>
									<growablecols>1</growablecols>

									<object class="sizeritem">
										<flag>wxALIGN_CENTER_VERTICAL</flag>
										<object class="wxStaticText">
											<label>Key:</label>
										</object>
									</object>
									<object class="sizeritem">
										<flag>wxALIGN_CENTER_VERTICAL</flag>
										<object class="wxStaticText">
											<label>Value:</label>
										</object>
									</object>

									<object class="sizeritem">
										<flag>wxEXPAND</flag>
										<object class="wxTextCtrl" name="txtVarKey1">
											<hint>KEY</hint>
										</object>
									</object>
									<object class="sizeritem">
										<flag>wxEXPAND</flag>
										<object class="wxTextCtrl" name="txtVarVal1">
											<hint>Value</hint>
										</object>
									</object>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxTOP</flag>
								<border>3</border>
								<object class="wxBoxSizer">
									<orient>wxHORIZONTAL</orient>
									<object class="sizeritem">
										<object class="wxButton" name="btnAddVariable">
											<label>+ Add</label>
											<size>80,-1</size>
										</object>
									</object>
									<object class="sizeritem">
										<flag>wxLEFT</flag>
										<border>5</border>
										<object class="wxButton" name="btnRemoveVariable">
											<label>- Remove</label>
											<size>80,-1</size>
										</object>
									</object>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>

			<!-- Bottom buttons -->
			<object class="sizeritem">
				<option>0</option>
				<flag>wxLEFT|wxRIGHT|wxEXPAND</flag>
				<border>5</border>
				<object class="wxCollapsiblePane" name="paneBatch">
					<label>Batch Operation</label>
					<object class="panewindow">
						<object class="wxBoxSizer">
							<orient>wxVERTICAL</orient>

							<object class="sizeritem">
								<option>0</option>
								<flag>wxBOTTOM|wxEXPAND</flag>
								<border>5</border>
								<object class="wxRadioBox" name="radioBatchMode">
									<label>Mode</label>
									<dimension>1</dimension>
									<content>
										<item>None (run on current project)</item>
										<item>Folder scan (repeat on files in folder)</item>
										<item>Slider sets (repeat on installed slider sets)</item>
									</content>
									<selection>0</selection>
								</object>
							</object>

							<!-- Folder scan options -->
							<object class="sizeritem">
								<option>0</option>
								<flag>wxEXPAND|wxBOTTOM</flag>
								<border>5</border>
								<object class="wxPanel" name="panelBatchFolder">
									<object class="wxStaticBoxSizer" name="boxBatchFolder">
										<orient>wxVERTICAL</orient>
										<label>Folder Scan Settings</label>
										<object class="sizeritem">
											<flag>wxALL|wxEXPAND</flag>
											<border>3</border>
											<object class="wxFlexGridSizer">
												<cols>2</cols>
												<vgap>5</vgap>
												<hgap>10</hgap>
												<growablecols>1</growablecols>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>Folder:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxDirPickerCtrl" name="dpBatchFolder">
														<message>Select folder to scan</message>
														<style>wxDIRP_DEFAULT_STYLE|wxDIRP_USE_TEXTCTRL</style>
													</object>
												</object>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>Extension:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxTextCtrl" name="txtBatchExtension">
														<value translate="0">.nif</value>
														<tooltip>File extension to scan for (e.g. .nif, .obj)</tooltip>
														<hint translate="0">.nif</hint>
													</object>
												</object>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>Options:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxCheckBox" name="chkBatchSubdirs">
														<label>Include subdirectories</label>
													</object>
												</object>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>File Filter:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxBoxSizer">
														<orient>wxHORIZONTAL</orient>
														<object class="sizeritem">
															<option>1</option>
															<flag>wxEXPAND|wxRIGHT</flag>
															<border>5</border>
															<object class="wxTextCtrl" name="txtBatchFileFilter">
																<tooltip>Filter file/folder names (substring or regex)</tooltip>
																<hint>Filter pattern...</hint>
															</object>
														</object>
														<object class="sizeritem">
															<flag>wxALIGN_CENTER_VERTICAL</flag>
															<object class="wxCheckBox" name="chkBatchFileFilterRegex">
																<label>Regex</label>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>
									</object>
								</object>
							</object>

							<!-- Slider set batch options -->
							<object class="sizeritem">
								<option>0</option>
								<flag>wxEXPAND</flag>
								<border>0</border>
								<object class="wxPanel" name="panelBatchSliderSets">
									<object class="wxStaticBoxSizer" name="boxBatchSliderSets">
										<orient>wxVERTICAL</orient>
										<label>Slider Set Settings</label>
										<object class="sizeritem">
											<flag>wxALL|wxEXPAND</flag>
											<border>3</border>
											<object class="wxFlexGridSizer">
												<cols>2</cols>
												<vgap>5</vgap>
												<hgap>10</hgap>
												<growablecols>1</growablecols>

												<object class="sizeritem">
													<flag>wxALIGN_CENTER_VERTICAL</flag>
													<object class="wxStaticText">
														<label>Filter:</label>
													</object>
												</object>
												<object class="sizeritem">
													<flag>wxEXPAND</flag>
													<object class="wxBoxSizer">
														<orient>wxHORIZONTAL</orient>
														<object class="sizeritem">
															<option>1</option>
															<flag>wxEXPAND|wxRIGHT</flag>
															<border>5</border>
															<object class="wxTextCtrl" name="txtBatchSliderSetFilter">
																<tooltip>Filter slider set names (substring or regex). Leave empty for all.</tooltip>
																<hint>Filter pattern...</hint>
															</object>
														</object>
														<object class="sizeritem">
															<flag>wxALIGN_CENTER_VERTICAL</flag>
															<object class="wxCheckBox" name="chkBatchSliderSetFilterRegex">
																<label>Regex</label>
															</object>
														</object>
													</object>
												</object>
											</object>
										</object>

										<!-- RefineMesh -->

									</object>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>

			<!-- Output log -->
			<object class="sizeritem">
				<option>0</option>
				<flag>wxLEFT|wxRIGHT|wxEXPAND</flag>
				<border>5</border>
				<object class="wxCollapsiblePane" name="paneOutput">
					<label>Output Log</label>
					<collapsed>1</collapsed>
				</object>
			</object>

			<!-- Execute buttons -->
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxHORIZONTAL</orient>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxRIGHT</flag>
						<border>5</border>
						<object class="wxButton" name="btnExecuteAll">
							<label>Execute</label>
							<tooltip>Execute all active steps in order</tooltip>
						</object>
					</object>
					<object class="spacer">
						<option>1</option>
						<flag>wxEXPAND</flag>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<object class="wxButton" name="wxID_CLOSE">
							<label>Close</label>
						</object>
					</object>
				</object>
			</object>

		</object>
	</object>
</resource>
