																		</object>
																	</object>
																	<object class="sizeritem">
																		<object class="wxCheckBox" name="chkExportWithRef">
																			<label>Export with reference shape (.nif only)</label>
																			<checked>1</checked>
																		</object>
																	</object>
																</object>
															</object>

