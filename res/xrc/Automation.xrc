																</object>
															</object>
															<object class="sizeritem">
																<flag>wxEXPAND</flag>
																<object class="wxBoxSizer">
																	<orient>wxVERTICAL</orient>
																	<object class="sizeritem">
																		<flag>wxEXPAND</flag>
																		<object class="wxFilePickerCtrl" name="fpExportFile">
																			<message>Select export file path</message>
																			<wildcard>NIF Files (*.nif)|*.nif|OBJ Files (*.obj)|*.obj|FBX Files (*.fbx)|*.fbx|OSD Files (*.osd)|*.osd|TRI Files (*.tri)|*.tri|All Files (*.*)|*.*</wildcard>
