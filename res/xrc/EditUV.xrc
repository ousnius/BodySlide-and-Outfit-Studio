<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<resource xmlns="http://www.wxwidgets.org/wxxrc" version="2.5.3.0">
	<object class="wxFrame" name="dlgEditUV">
		<style>wxFRAME_FLOAT_ON_PARENT|wxCAPTION|wxRESIZE_BORDER|wxMAXIMIZE_BOX|wxCLOSE_BOX</style>
		<title>Edit UV</title>
		<bg>#707070</bg>
		<centered>1</centered>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			<minsize>600,600</minsize>
			<object class="sizeritem">
				<option>1</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>0</border>
				<object class="unknown" name="uvGLView" />
			</object>
			<object class="spacer">
				<option>0</option>
				<flag>wxEXPAND</flag>
				<border>5</border>
				<size>0,5</size>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxALL</flag>
				<border>5</border>
				<object class="wxStdDialogButtonSizer">
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_OK">
							<label>&amp;OK</label>
						</object>
					</object>
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_CANCEL">
							<label>&amp;Cancel</label>
						</object>
					</object>
				</object>
			</object>
		</object>
	</object>
	<object class="wxToolBar" name="uvToolBar">
		<style>wxTB_HORIZONTAL|wxTB_FLAT</style>
		<bg>#707070</bg>
		<fg>#ffffff</fg>
		<separation>5</separation>
		<object class="tool" name="btnBoxSelection">
			<label>Box Selection</label>
			<tooltip>Box Selection\nShortcut: 1</tooltip>
			<bitmap>$(AppDir)\res\images\MaskBrush.png</bitmap>
			<bitmap2>$(AppDir)\res\images\MaskBrush_d.png</bitmap2>
			<radio>1</radio>
			<checked>1</checked>
		</object>
		<object class="tool" name="btnVertexSelection">
			<label>Vertex Selection</label>
			<tooltip>Vertex Selection\nShortcut: 2</tooltip>
			<bitmap>$(AppDir)\res\images\SelectBrush.png</bitmap>
			<bitmap2>$(AppDir)\res\images\SelectBrush_d.png</bitmap2>
			<radio>1</radio>
		</object>
		<object class="tool" name="btnMove">
			<label>Move</label>
			<tooltip>Move\nShortcut: 3</tooltip>
			<bitmap>$(AppDir)\res\images\MoveBrush.png</bitmap>
			<bitmap2>$(AppDir)\res\images\MoveBrush_d.png</bitmap2>
			<radio>1</radio>
		</object>
		<object class="tool" name="btnScale">
			<label>Scale</label>
			<tooltip>Scale\nShortcut: 4</tooltip>
			<bitmap>$(AppDir)\res\images\TransformTool.png</bitmap>
			<bitmap2>$(AppDir)\res\images\TransformTool_d.png</bitmap2>
			<radio>1</radio>
		</object>
		<object class="tool" name="btnRotate">
			<label>Rotate</label>
			<tooltip>Rotate\nShortcut: 5</tooltip>
			<bitmap>$(AppDir)\res\images\RotateTool.png</bitmap>
			<bitmap2>$(AppDir)\res\images\RotateTool_d.png</bitmap2>
			<radio>1</radio>
		</object>
		<object class="tool" name="btnSeamEdges">
			<label>Show Seam Edges</label>
			<tooltip>Show Seam Edges</tooltip>
			<bitmap>$(AppDir)\res\images\SeamEdges.png</bitmap>
			<bitmap2>$(AppDir)\res\images\SeamEdges_d.png</bitmap2>
			<toggle>1</toggle>
			<checked>1</checked>
		</object>
	</object>
	<object class="wxMenuBar" name="uvMenuBar">
		<label>Menu</label>
		<object class="wxMenu" name="menuFile">
			<label>File</label>
			<object class="wxMenuItem" name="fileExportUVTemplate">
				<label>Export UV Template...\tCtrl+E</label>
				<help>Export the UV layout as an image file.</help>
			</object>
		</object>
		<object class="wxMenu" name="menuEdit">
			<label>Edit</label>
			<object class="wxMenuItem" name="editUndo">
				<label>Undo\tCtrl+Z</label>
				<help>Undo the previous action.</help>
			</object>
			<object class="wxMenuItem" name="editRedo">
				<label>Redo\tCtrl+Y</label>
				<help>Redo the next undone action.</help>
			</object>
			<object class="separator" />
			<object class="wxMenuItem" name="editSelectAll">
				<label>Select All\tCtrl+A</label>
				<help>Select All</help>
			</object>
			<object class="wxMenuItem" name="editSelectInvert">
				<label>Invert Selection\tCtrl+I</label>
				<help>Invert Selection</help>
			</object>
			<object class="wxMenuItem" name="editSelectLess">
				<label>Select Less\tA</label>
				<help>Select less adjacent points in the selected islands.</help>
			</object>
			<object class="wxMenuItem" name="editSelectMore">
				<label>Select More\tD</label>
				<help>Select more adjacent points in the selected islands.</help>
			</object>
			<object class="separator" />
			<object class="wxMenuItem" name="maskSelection">
				<label>Mask Selection</label>
				<help>Create a mask from the current UV selection for the mesh in the main viewport.</help>
			</object>
			<object class="separator" />
			<object class="wxMenuItem" name="editTranslate">
				<label>Translate...\tT</label>
				<help>Show a dialog to translate the current selection.</help>
			</object>
			<object class="wxMenuItem" name="editRotate">
				<label>Rotate...\tR</label>
				<help>Show a dialog to rotate the current selection.</help>
			</object>
			<object class="wxMenuItem" name="editScale">
				<label>Scale...\tS</label>
				<help>Show a dialog to scale the current selection.</help>
			</object>
		</object>
	</object>
	<object class="wxDialog" name="dlgTranslate">
		<style>wxCAPTION|wxDEFAULT_DIALOG_STYLE</style>
		<size>414,169</size>
		<title>Translate</title>
		<centered>1</centered>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxVERTICAL</orient>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALL</flag>
						<border>5</border>
						<object class="wxBoxSizer">
							<orient>wxHORIZONTAL</orient>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxStaticText" name="labelU">
									<label translate="0">U</label>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxSlider" name="sliderU">
									<value translate="0">0</value>
									<min>-2000</min>
									<max>2000</max>
									<size>400,-1</size>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxTextCtrl" name="textU">
									<size>60,-1</size>
									<value translate="0">0.00000</value>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxVERTICAL</orient>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALL</flag>
						<border>5</border>
						<object class="wxBoxSizer">
							<orient>wxHORIZONTAL</orient>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxStaticText" name="labelV">
									<label translate="0">V</label>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxSlider" name="sliderV">
									<value translate="0">0</value>
									<min>-2000</min>
									<max>2000</max>
									<size>400,-1</size>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxTextCtrl" name="textV">
									<size>60,-1</size>
									<value translate="0">0.00000</value>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>1</option>
				<flag>wxEXPAND|wxALL</flag>
				<border>5</border>
				<object class="wxStdDialogButtonSizer">
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_OK">
							<label>&amp;OK</label>
						</object>
					</object>
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_CANCEL">
							<label>&amp;Cancel</label>
						</object>
					</object>
				</object>
			</object>
		</object>
	</object>
	<object class="wxDialog" name="dlgRotate">
		<style>wxCAPTION|wxDEFAULT_DIALOG_STYLE</style>
		<size>423,155</size>
		<title>Rotate</title>
		<centered>1</centered>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxVERTICAL</orient>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALL</flag>
						<border>0</border>
						<object class="wxBoxSizer">
							<orient>wxHORIZONTAL</orient>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxStaticText" name="label">
									<label>Angle</label>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxSlider" name="slider">
									<value translate="0">0</value>
									<min>-18000</min>
									<max>18000</max>
									<size>400,-1</size>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxTextCtrl" name="text">
									<size>60,-1</size>
									<value translate="0">0.0000</value>
								</object>
							</object>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>1</option>
				<flag>wxEXPAND|wxALL</flag>
				<border>5</border>
				<object class="wxStdDialogButtonSizer">
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_OK">
							<label>&amp;OK</label>
						</object>
					</object>
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_CANCEL">
							<label>&amp;Cancel</label>
						</object>
					</object>
				</object>
			</object>
		</object>
	</object>
	<object class="wxDialog" name="dlgScale">
		<style>wxCAPTION|wxDEFAULT_DIALOG_STYLE</style>
		<size>423,250</size>
		<title>Scale</title>
		<centered>1</centered>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>5</border>
				<object class="wxBoxSizer">
					<orient>wxVERTICAL</orient>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALL</flag>
						<border>0</border>
						<object class="wxBoxSizer">
							<orient>wxHORIZONTAL</orient>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxStaticText" name="labelU">
									<label translate="0">U</label>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxSlider" name="sliderU">
									<value translate="0">1000</value>
									<min>10</min>
									<max>3000</max>
									<size>400,-1</size>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxTextCtrl" name="textU">
									<size>60,-1</size>
									<value translate="0">1.00000</value>
								</object>
							</object>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALL</flag>
						<border>0</border>
						<object class="wxBoxSizer">
							<orient>wxHORIZONTAL</orient>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxStaticText" name="labelV">
									<label translate="0">V</label>
									<wrap>-1</wrap>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxSlider" name="sliderV">
									<value translate="0">1000</value>
									<min>10</min>
									<max>3000</max>
									<size>400,-1</size>
								</object>
							</object>
							<object class="sizeritem">
								<option>0</option>
								<flag>wxLEFT|wxRIGHT</flag>
								<border>5</border>
								<object class="wxTextCtrl" name="textV">
									<size>60,-1</size>
									<value translate="0">1.00000</value>
								</object>
							</object>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALL</flag>
						<border>5</border>
						<object class="wxCheckBox" name="cbUniform">
							<label>Uniform (UV)</label>
							<checked>1</checked>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>1</option>
				<flag>wxEXPAND|wxALL</flag>
				<border>5</border>
				<object class="wxStdDialogButtonSizer">
					<object class="button">
					<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
					<border>5</border>
					<object class="wxButton" name="wxID_OK">
						<label>&amp;OK</label>
					</object>
				</object>
				<object class="button">
					<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
					<border>5</border>
					<object class="wxButton" name="wxID_CANCEL">
						<label>&amp;Cancel</label>
					</object>
				</object>
				</object>
			</object>
		</object>
	</object>
	<object class="wxDialog" name="dlgExportUV">
		<style>wxCAPTION|wxDEFAULT_DIALOG_STYLE</style>
		<title>Export UV Template</title>
		<centered>1</centered>
		<object class="wxBoxSizer">
			<orient>wxVERTICAL</orient>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxALL|wxEXPAND</flag>
				<border>10</border>
				<object class="wxFlexGridSizer">
					<cols>2</cols>
					<vgap>8</vgap>
					<hgap>10</hgap>
					<growablecols>1</growablecols>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALIGN_CENTER_VERTICAL</flag>
						<object class="wxStaticText">
							<label>Resolution</label>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND</flag>
						<object class="wxChoice" name="choiceResolution">
							<content>
								<item>512 x 512</item>
								<item>1024 x 1024</item>
								<item>2048 x 2048</item>
								<item>4096 x 4096</item>
							</content>
							<selection>2</selection>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALIGN_CENTER_VERTICAL</flag>
						<object class="wxStaticText">
							<label>Wire Color</label>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<object class="wxColourPickerCtrl" name="cpWireColor">
							<colour>#FFFFFF</colour>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALIGN_CENTER_VERTICAL</flag>
						<object class="wxStaticText">
							<label>Background Color</label>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<object class="wxColourPickerCtrl" name="cpBackgroundColor">
							<colour>#000000</colour>
						</object>
					</object>
					<object class="spacer">
						<size>0,0</size>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<object class="wxCheckBox" name="cbTransparentBG">
							<label>Transparent Background</label>
							<checked>1</checked>
						</object>
					</object>
					<object class="spacer">
						<size>0,0</size>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<object class="wxCheckBox" name="cbIncludeTexture">
							<label>Include Texture</label>
							<checked>0</checked>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxALIGN_CENTER_VERTICAL</flag>
						<object class="wxStaticText">
							<label>Wrap Mode</label>
						</object>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<flag>wxEXPAND</flag>
						<object class="wxChoice" name="choiceWrapMode">
							<content>
								<item>Wrap</item>
								<item>Clamp</item>
							</content>
							<selection>0</selection>
						</object>
					</object>
					<object class="spacer">
						<size>0,0</size>
					</object>
					<object class="sizeritem">
						<option>0</option>
						<object class="wxCheckBox" name="cbAntiAliasing">
							<label>Anti-Aliasing</label>
							<checked>1</checked>
						</object>
					</object>
				</object>
			</object>
			<object class="sizeritem">
				<option>0</option>
				<flag>wxEXPAND|wxALL</flag>
				<border>10</border>
				<object class="wxStdDialogButtonSizer">
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_OK">
							<label>&amp;OK</label>
						</object>
					</object>
					<object class="button">
						<flag>wxALIGN_CENTER_HORIZONTAL|wxALL</flag>
						<border>5</border>
						<object class="wxButton" name="wxID_CANCEL">
							<label>&amp;Cancel</label>
						</object>
					</object>
				</object>
			</object>
		</object>
	</object>
</resource>
